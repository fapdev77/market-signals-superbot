# ==============================================================================
# Market Signals SuperBot - Environment Configuration Example
# ==============================================================================

# --- SECURITY & AUTHENTICATION (Phase 1) ---
# Required in production: Bearer token for API endpoints authorization
API_AUTH_TOKEN="superbot_secure_token_change_in_production"

# Network Host & Port
HOST="0.0.0.0"
PORT="3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional list of custom hostnames allowed for AI outbound requests (comma-separated)
ALLOWED_AI_HOSTS="openrouter.ai,api.anthropic.com,api.openai.com"

# Maximum tolerated age for market data in milliseconds (default: 60000)
MAX_DATA_AGE_MS="60000"

# Flag to enable synthetic data mode for offline development (default: false)
ALLOW_SYNTHETIC_DATA="false"

# --- AI API KEYS ---
# GEMINI_API_KEY: Required for Gemini AI quantitative signal reviews
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Optional keys for external providers
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""

# --- APP CONFIGURATION ---
APP_URL="http://localhost:3000"
