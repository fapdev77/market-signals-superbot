# ==============================================================================
# Market Signals SuperBot - Environment Configuration Example
# ==============================================================================

# --- SECURITY & AUTHENTICATION (Phase 1) ---
# Required in production: Bearer token for API endpoints authorization
API_AUTH_TOKEN="superbot_secure_token_change_in_production"

# Network Host & Port (M4.1)
# Default is 127.0.0.1. In production, 0.0.0.0 requires ALLOW_PUBLIC_BIND="true".
HOST="127.0.0.1"
PORT="3000"
ALLOW_PUBLIC_BIND="false"

# --- OPERATIONAL ALERTS (M4.7) ---
# Optional webhook URL for critical operational alerts (POST JSON)
ALERT_WEBHOOK_URL=""

# Optional Telegram bot alerts
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# CORS allowlist. In production ONLY these exact origins are accepted (no wildcard, no *.run.app
# suffix matching). In development any origin is accepted for local tooling.
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Optional list of custom hostnames allowed for AI outbound requests (comma-separated)
ALLOWED_AI_HOSTS="openrouter.ai,api.anthropic.com,api.openai.com"

# Maximum tolerated age for market data in milliseconds (default: 60000)
MAX_DATA_AGE_MS="60000"

# Flag to enable synthetic data mode for offline development (default: false)
ALLOW_SYNTHETIC_DATA="false"

# --- AI API KEYS ---
# GEMINI_API_KEY: Required for Gemini AI quantitative signal reviews
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# Optional keys for external providers
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""

# --- APP CONFIGURATION ---
APP_URL="http://localhost:3000"

# Ambiente de execução (production ativa CSP report-only, bind restrito e token via arquivo)
NODE_ENV="development"

# Desabilita HMR do Vite em ambientes de desenvolvimento assistidos (default: false)
DISABLE_HMR="false"

# --- 6.8.1 STREAM DE PREÇOS PELO SERVIDOR (SSE) ---
# Intervalo entre snapshots de tickers do /api/stream/tickers (ms; default 3000, mínimo 500)
STREAM_TICKERS_INTERVAL_MS="3000"
# Cap de snapshots por conexão — SOMENTE para testes HTTP; nunca definir em produção
# STREAM_TICKERS_MAX_SNAPSHOTS=""

# --- 6.8.2 / 7.6.2 CSP ---
# Endpoint opcional que coleta violações de Content-Security-Policy (report-uri)
CSP_REPORT_URI=""
# 7.6.2 — Ativa o cabeçalho Content-Security-Policy em imposição (produção).
# Requer ≥7 dias de report-only sem violações inesperadas. Default: false (report-only).
CSP_ENFORCE="false"

# --- 6.7 CICLO PENDING_ENTRY (D8) ---
# 8.2.4 — a flag segue o veredito registrado em docs/evidence/entry-confirmation-verdict.json.
# Veredito DEFINITIVO (2026-10-03, regra v2, universo de 5 símbolos reais): MANTER DESLIGADA
# — a confirmação melhora a expectativa pareada (+0.2464 R, IC95% > 0) e reduz o drawdown,
# mas o braço com confirmação ainda tem expectativa ABSOLUTA negativa (-0.1659 R) e a
# condição (d) da regra 8.2.2 não permite ligar. O teste flagMatchesDecision.test.ts
# falha se esta flag divergir do veredito.
ENTRY_CONFIRMATION_ENABLED="false"

# Thresholds da confirmação de entrada (D6, sobreponíveis por env)
ENTRY_MAX_WICK_RATIO="0.55"
ENTRY_TAKER_BUY_LONG="0.49"
ENTRY_TAKER_BUY_SHORT="0.51"
ENTRY_MIN_CONFLUENCE="60"

# Teto do stop por categoria (D7 — p75 calibrado; sobreponha pontualmente se necessário)
MAX_STOP_PCT_SCALP="1.75"
MAX_STOP_PCT_DAY_TRADE="1.85"
MAX_STOP_PCT_INTRADAY="2.0"
MAX_STOP_PCT_COUNTER_TRADE="2.30"
MAX_STOP_PCT_SWING="3.2"
MAX_STOP_PCT_POSITION="5.3"
MAX_STOP_PCT_CUSTOM="2.0"

# --- SLIPPAGE / FUNDING / TRADFI / INFRA ---
# Slippage máximo estimado aceito para marcar um sinal como executável (6.5.2)
MAX_ESTIMATED_SLIPPAGE_PCT="0.05"

# Orçamento de requisições/minuto para sincronização de funding histórico (6.3)
FUNDING_SYNC_BUDGET_PER_MINUTE=""

# 8.3.1 — Teto de símbolos por execução do backtest agendado (default: 12)
SCHEDULER_MAX_SYMBOLS_PER_RUN=""

# 8.3.2 — Teto de símbolos por execução da sincronização de funding (default: TRADFI_MAX_MONITORED)
FUNDING_SYNC_MAX_SYMBOLS=""

# Sessões TradFi permitidas (ex.: REGULAR,EXTENDED; default: REGULAR)
TRADFI_ALLOWED_SESSIONS=""
# Bônus de score mínimo para estender sessão TradFi (opcional)
TRADFI_EXTENDED_MIN_SCORE_BONUS=""
# Fallback do calendário de trading TradFi (quando exchangeInfo indisponível)
TRADFI_SCHEDULE_FALLBACK=""
# 7.1.2 — Lista de símbolos TradFi monitorados (CSV, fonte única; interseção com o registro descoberto).
# Default: TSLAUSDT,NVDAUSDT,AAPLUSDT,SPYUSDT,QQQUSDT,XAUUSDT,PAXGUSDT
TRADFI_MONITORED_SYMBOLS=""
# 7.1.2 — Teto de símbolos TradFi monitorados (default: 10)
TRADFI_MAX_MONITORED="10"

# 7.3.2 — Intervalo da reconciliação periódica do ledger (ms; default: 900000 = 15 min)
LEDGER_RECONCILE_INTERVAL_MS="900000"

# Heartbeat externo opcional (6.6.4) — URL recebe POST a cada intervalo
HEARTBEAT_URL=""

# Chave da OpenAI (provedor opcional de auditoria IA)
OPENAI_API_KEY=""

# Metadados de build (informativos; preenchidos pelo pipeline de deploy)
ENGINE_VERSION=""
GIT_COMMIT_SHA=""
